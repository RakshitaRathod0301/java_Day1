5. COUNT THE DIGITS THAT DIVIDE THE NUMBER
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number: ");
        int num = sc.nextInt();

        int n = num;
        int count = 0;

        while (n > 0) {
            int digit = n % 10;

            if (digit != 0 && num % digit == 0)
                count++;

            n /= 10;
        }

        System.out.println("Count: " + count);

        sc.close();
    }
}