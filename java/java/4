4. NUMBER OF 1 BITS
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter an integer: ");
        int n = sc.nextInt();

        int count = 0;

        while (n != 0) {
            count += n & 1;
            n >>>= 1;
        }

        System.out.println("Number of 1 bits: " + count);

        sc.close();
    }
}