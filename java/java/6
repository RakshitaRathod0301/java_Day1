6. NUMBER OF STEPS TO REDUCE A NUMBER TO ZERO
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number: ");
        int num = sc.nextInt();

        int steps = 0;

        while (num > 0) {
            if (num % 2 == 0)
                num = num / 2;
            else
                num = num - 1;

            steps++;
        }

        System.out.println("Number of steps: " + steps);

        sc.close();
    }
}